generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  wallet         String    @unique
  email          String?
  name           String?
  image          String?
  authProvider   String?
  authSubject    String?
  favoriteChains String    @default("") // comma separated list of chain ids, it's not an array because sqlite doesn't support it
  webHooks       WebHook[] // relation to links the user made for chains

  @@unique([authProvider, authSubject])
}

model WebHook {
  id                  Int     @id @default(autoincrement())
  userId              Int
  chainId             String
  label               String
  notificationType    String
  notifyBeforeUpgrade String? // legacy fixed-window token, kept for transition
  notifyBeforeMinutes Int? // flexible lead time, in minutes
  url                 String

  user       User              @relation(fields: [userId], references: [id])
  deliveries WebHookDelivery[]

  @@index([userId])
}

model WebHookDelivery {
  id           Int      @id @default(autoincrement())
  webHookId    Int
  eventKey     String
  status       String
  responseCode Int?
  responseText String?
  error        String?
  deliveredAt  DateTime @default(now())

  webHook WebHook @relation(fields: [webHookId], references: [id])

  @@unique([webHookId, eventKey])
  @@index([eventKey])
}
