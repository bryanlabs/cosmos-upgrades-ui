# Copy to .env.local and fill in. Never commit real secrets (.env* is gitignored).

# Prisma SQLite database location.
DATABASE_URL="file:./prisma/dev.db"

# Upstream Cosmos Upgrades API (server-side fetches + notification dispatch).
COSMOS_UPGRADES_API_BASE_URL="https://cosmos-upgrades.bryanlabs.net"

# --- Auth (NextAuth + Authentik) ---
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_AUTHENTIK_ISSUER="https://authentik.media.bryanlabs.net/application/o/upgrade-hub/"
AUTH_AUTHENTIK_ID="bryanlabs-upgrade-hub"
AUTH_AUTHENTIK_SECRET=""

# --- Notifications ---
# Shared bearer token the dispatch CronJob uses to call POST /api/notifications/dispatch.
NOTIFICATION_DISPATCH_TOKEN=""
# AES-256 key (base64, 32 bytes) used to encrypt stored webhook URLs at rest.
# Generate with: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=""

# --- Public (inlined into the client bundle at build time) ---
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=""
NEXT_PUBLIC_AUTHENTIK_END_SESSION_URL="https://authentik.media.bryanlabs.net/application/o/upgrade-hub/end-session/"
# Set to "true" to load local mock chain data instead of the live API.
# NEXT_PUBLIC_MOCK_ENABLED="true"
